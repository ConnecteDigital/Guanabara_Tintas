---
interface Props {
  name: 'whatsapp' | 'phone' | 'pin' | 'clock' | 'mail' | 'instagram' | 'arrow' | 'card' | 'truck' | 'store' | 'pix';
  size?: number;
}
const { name, size = 22 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'whatsapp' && (
    <>
      <path d="M20.5 11.6a8.6 8.6 0 0 1-12.7 7.5L3.5 20.4l1.3-4.1a8.6 8.6 0 1 1 15.7-4.7Z" />
      <path d="M9 8.2c.3-.3.7-.3.9-.1l1 1.4c.2.3.2.6-.1.9l-.5.5c.5 1.1 1.4 2 2.5 2.5l.5-.5c.3-.3.6-.3.9-.1l1.4 1c.3.2.3.6.1.9-.5.5-1 .9-1.7.9-3.5-.4-6.2-3.1-6.6-6.6 0-.7.4-1.2.9-1.7Z" />
    </>
  )}
  {name === 'phone' && <path d="M5 4h3.5l1.5 4-2 1.3a11 11 0 0 0 6.7 6.7L16 14l4 1.5V19a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z" />}
  {name === 'pin' && (
    <>
      <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2.5" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
    </>
  )}
  {name === 'arrow' && <path d="M7 17 17 7M9 7h8v8" />}
  {name === 'card' && (
    <>
      <rect x="2.5" y="5.5" width="19" height="13" rx="2.5" />
      <path d="M2.5 10h19M6 15h4" />
    </>
  )}
  {name === 'truck' && (
    <>
      <path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7" />
      <circle cx="6.5" cy="17.5" r="1.8" />
      <circle cx="16.5" cy="17.5" r="1.8" />
    </>
  )}
  {name === 'store' && (
    <>
      <path d="M4 10v10h16V10M3 10l2-6h14l2 6M3 10a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0" />
      <path d="M10 20v-5h4v5" />
    </>
  )}
  {name === 'pix' && <path d="m12 3 4 4-4 4-4-4 4-4Zm0 10 4 4-4 4-4-4 4-4ZM3 12l4-4 4 4-4 4-4-4Zm10 0 4-4 4 4-4 4-4-4Z" />}
</svg>
